  "components": [
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "quiet-button",
      "description": "实际透明轻按钮；SVG内联。纸纹与字体文件不嵌入，独立预览使用已列明的字体回退。",
      "html": "<button class=\"ds-quiet\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 12H5m6-6-6 6 6 6\"/></svg><span>回到荷塘</span></button>",
      "css": ".ds-quiet{display:inline-flex;align-items:center;gap:10px;padding:7px 0;background:none;border:0;border-radius:0;color:var(--ink,#292c29);font-size:12px;letter-spacing:.05em;cursor:pointer;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;}.ds-quiet svg{width:20px;height:20px;flex:none}.ds-quiet:hover{color:var(--lotus,#8d667c)}.ds-quiet:focus-visible{outline:2px solid var(--lotus,#8d667c);outline-offset:7px;}.ds-quiet:disabled{opacity:.28;cursor:default}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "实际关闭／前后操作的图标按钮；无填色或容器阴影。",
      "html": "<button class=\"ds-icon\" aria-label=\"关闭图片\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button>",
      "css": ".ds-icon{width:36px;height:36px;padding:7px;display:flex;align-items:center;justify-content:center;border:0;border-radius:0;background:none;color:var(--ink,#292c29);cursor:pointer}.ds-icon svg{width:22px;height:22px;flex:none}.ds-icon:hover:not(:disabled){color:var(--lotus,#8d667c)}.ds-icon:focus-visible{outline:2px solid var(--lotus,#8d667c);outline-offset:7px;}.ds-icon:disabled{opacity:.28;cursor:default}"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "refersTo": "text-action",
      "description": "案例末尾的细线文字操作，状态沿用实际轻控件。",
      "html": "<button class=\"ds-text\"><span>回到作品长卷</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text{display:inline-flex;align-items:center;gap:13px;font-size:13px;text-decoration:none;border:0;border-bottom:1px solid #66654d;padding:8px 0 7px;background:none;border-radius:0;color:var(--ink,#292c29);cursor:pointer;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;}.ds-text svg{width:22px;height:22px;flex:none}.ds-text:hover{color:var(--lotus,#8d667c)}.ds-text:focus-visible{outline:2px solid var(--lotus,#8d667c);outline-offset:7px;}"
    },
    {
      "name": "Gallery Position Navigation",
      "kind": "nav",
      "refersTo": "gallery-position",
      "description": "八个实际菱形位置控件；aria-current表达当前项。独立预览不包含React滚动事件。",
      "html": "<nav class=\"ds-progress\" aria-label=\"作品位置\"><button aria-label=\"移至MOSIC\" aria-current=\"true\"><span></span></button><button aria-label=\"移至Meet Countdown\"><span></span></button><button aria-label=\"移至Water Reminder\"><span></span></button><button aria-label=\"移至Moce Worldmaker\"><span></span></button><button aria-label=\"移至Moce Designer\"><span></span></button><button aria-label=\"移至Luke Teleprompter\"><span></span></button><button aria-label=\"移至Huazhi Displayboard\"><span></span></button><button aria-label=\"移至LanBridge\"><span></span></button></nav>",
      "css": ".ds-progress{display:flex;align-items:center;gap:3px}.ds-progress button{width:25px;height:30px;padding:8px 5px;display:flex;align-items:center;justify-content:center;border:0;background:none;cursor:pointer}.ds-progress span{display:block;width:5px;height:5px;background:#747360;opacity:.5;transform:rotate(45deg);transition:width .4s,opacity .4s}.ds-progress [aria-current=true] span{width:13px;opacity:1;background:#654a58}.ds-progress button:focus-visible{outline:2px solid var(--lotus,#8d667c);outline-offset:7px;}@media(prefers-reduced-motion:reduce){.ds-progress span{transition-duration:.01ms}}"
    },
    {
      "name": "Static Fallback Project Entry",
      "kind": "button",
      "refersTo": "fallback-entry",
      "description": "实际非WebGL入口；不是实时鱼命中层，也不伪造场景。",
      "html": "<button class=\"ds-fallback\"><span>MOSIC</span></button>",
      "css": ".ds-fallback{position:relative;min-height:64px;padding:12px 16px;background:#ead3a0ed;border:0;border-radius:0;color:var(--ink,#292c29);display:flex;align-items:center;justify-content:center;white-space:normal;cursor:pointer}.ds-fallback span{font-size:15px;line-height:1.5;text-align:center;overflow-wrap:anywhere;font-family:\"Folio Serif\",\"Noto Serif SC\",serif;}.ds-fallback:hover,.ds-fallback:focus-visible{background:#f6ebcd;outline:2px solid #8d667c;outline-offset:3px;border-radius:0}"
    },
    {
      "name": "Project Leaf — Static Fallback",
      "kind": "custom",
      "refersTo": "project-leaf",
      "description": "仅示范实际回退叶的DOM标题与墨灰填充。多边形轮廓是便于独立预览的简化近似，不是程序叶的精确采样；不复现Three.js杯形、徽记、光照、遮挡、Bayer抖色或交互放大。",
      "html": "<button class=\"ds-leaf\" aria-label=\"展开MOSIC：音乐星球\"><span class=\"ds-leaf-title\">MOSIC<span>音乐星球</span></span></button>",
      "css": ".ds-leaf{position:relative;width:320px;height:253px;display:flex;align-items:center;justify-content:center;padding:0;background:#474d42;border:0;color:#f5e9cc;cursor:pointer;clip-path:polygon(96% 46%,91% 70%,71% 91%,48% 97%,24% 87%,7% 67%,3% 44%,17% 18%,42% 4%,68% 11%,77% 26%,62% 38%,89% 29%)}.ds-leaf-title{position:absolute;left:10%;right:10%;top:63%;font-size:clamp(22px,2.4vw,39px);line-height:1.3;letter-spacing:-.025em;font-weight:500;text-align:center;text-wrap:balance;text-shadow:0 1px 7px #20241fd9;font-family:\"Folio Serif\",\"Noto Serif SC\",serif;}.ds-leaf-title>span{display:block;font-size:11px;letter-spacing:.12em;font-weight:400;margin-top:13px;opacity:.92;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;}.ds-leaf:focus-visible{outline:none}.ds-leaf:focus-visible .ds-leaf-title::after{content:\"\";position:absolute;left:20%;right:20%;bottom:-12px;border-bottom:1px solid #f5e9cc}"
    },
    {
      "name": "Viewer Toggle",
      "kind": "button",
      "description": "截图查看器实际文字切换状态；暗色底仅为预览的局部上下文。独立预览不载入或切换媒体。",
      "html": "<div class=\"ds-viewer\"><button aria-pressed=\"true\">返回抖色</button><button aria-pressed=\"false\">原尺寸</button></div>",
